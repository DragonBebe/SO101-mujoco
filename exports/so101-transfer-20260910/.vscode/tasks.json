{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "SO101: 启动自然语言控制环境",
      "type": "process",
      "command": "bash",
      "args": ["${workspaceFolder}/LLM-control/run_loop.sh", "serve", "--viewer", "--realtime", "--camera-viewer"],
      "options": {"cwd": "${workspaceFolder}", "env": {"MUJOCO_GL": "glfw"}},
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {"reveal": "always", "panel": "dedicated"}
    },
    {
      "label": "SO101: 查看任务状态",
      "type": "process",
      "command": "bash",
      "args": ["${workspaceFolder}/LLM-control/run_loop.sh", "status"],
      "problemMatcher": []
    },
    {
      "label": "SO101: 暂停任务",
      "type": "process",
      "command": "bash",
      "args": ["${workspaceFolder}/LLM-control/run_loop.sh", "command", "{\"action\":\"pause\"}"],
      "problemMatcher": []
    },
    {
      "label": "SO101: 关闭环境",
      "type": "process",
      "command": "bash",
      "args": ["${workspaceFolder}/LLM-control/run_loop.sh", "command", "{\"action\":\"shutdown\"}"],
      "problemMatcher": []
    }
  ]
}
