<?xml version="1.0" ?>
<mujoco model="so101_custom_scene">
    <!-- 包含你修改过的机械臂模型 -->
    <include file="so101_new_calib.xml" />
    
    <compiler angle="radian" autolimits="true" />
    
    <option timestep="0.002" integrator="implicitfast" solver="PGS" gravity="0 0 -9.82" cone="elliptic" />
    
    <!-- 统计信息（用于自动调整视角） -->
    <statistic center="0.5 0.5 0.8" extent="1.5" meansize="0.1" />
    
    <!-- 可视化设置 -->
    <visual>
        <headlight diffuse="0.7 0.7 0.7" ambient="0.3 0.3 0.3" specular="0.1 0.1 0.1" />
        <rgba haze="0.15 0.25 0.35 1" />
        <global azimuth="30" elevation="-25" offheight="800" offwidth="800"/>
    </visual>
    
    <asset>
        <!-- 天空盒 -->
        <texture type="skybox" builtin="gradient" rgb1="0.4 0.6 0.8" rgb2="0.1 0.1 0.1" 
                 width="512" height="3072" />
        
        <!-- 地面纹理 -->
        <texture type="2d" name="groundplane" builtin="checker" mark="edge" 
                 rgb1="0.3 0.3 0.3" rgb2="0.2 0.2 0.2" markrgb="0.8 0.8 0.8" 
                 width="300" height="300" />
        <material name="groundplane" texture="groundplane" texuniform="true" 
                  texrepeat="8 8" reflectance="0.1" />
                  
        <!-- 桌面材质 -->
        <material name="table_mat" rgba="0.8 0.6 0.4 1" />
        
        <!-- 物体材质 -->
        <material name="red_mat" rgba="1 0.2 0.2 1" />
        <material name="blue_mat" rgba="0.2 0.2 1 1" />
        <material name="green_mat" rgba="0.2 1 0.2 1" />
    </asset>
    
    <worldbody>
        <!-- 主光源 -->
        <light pos="1 1 2" dir="0 0 -1" directional="true" diffuse="0.8 0.8 0.8" />
        <!-- 辅助光源 -->
        <light pos="-1 -1 1.5" dir="0 0 -1" directional="true" diffuse="0.3 0.3 0.3" />
        
        <!-- 地面 -->
        <geom name="floor" size="0 0 0.02" type="plane" material="groundplane" />
        
        <!-- 参考坐标轴 -->
        <geom name="x-axis" group="2" type="cylinder" contype="0" conaffinity="0"
              fromto="0 0 0 0.5 0 0" size="0.005" rgba="1 0 0 0.8" />
        <geom name="y-axis" group="2" type="cylinder" contype="0" conaffinity="0"
              fromto="0 0 0 0 0.5 0" size="0.005" rgba="0 1 0 0.8" />
        <geom name="z-axis" group="2" type="cylinder" contype="0" conaffinity="0"
              fromto="0 0 0 0 0 0.5" size="0.005" rgba="0 0 1 0.8" />
        
        <!-- 工作台 -->
        <body name="work_table" pos="0.6 0 0.4">
            <geom name="work_table" type="box" size="0.4 0.3 0.02" material="table_mat" />
        </body>
        
        <!-- 测试物体 -->
        <body name="red_box" pos="0.8 0.2 0.45">
            <joint name="red_box_joint" type="free" />
            <geom name="red_box" type="box" size="0.03 0.03 0.03" material="red_mat" mass="0.1" />
        </body>
        
        <body name="blue_cylinder" pos="0.4 0.1 0.45">
            <joint name="blue_cylinder_joint" type="free" />
            <geom name="blue_cylinder" type="cylinder" size="0.025 0.04" material="blue_mat" mass="0.08" />
        </body>
        
        <body name="green_sphere" pos="0.6 -0.2 0.45">
            <joint name="green_sphere_joint" type="free" />
            <geom name="green_sphere" type="sphere" size="0.03" material="green_mat" mass="0.06" />
        </body>
        
        <!-- 目标区域标记 -->
        <body name="target_zone" pos="0.2 0.2 0.42">
            <geom name="target_zone" type="cylinder" size="0.08 0.005" 
                  rgba="1 1 0 0.3" contype="0" conaffinity="0" />
        </body>
        
        <!-- 摄像机位置 -->
        <camera name="overview" pos="1.2 0.8 1.0" xyaxes="0 -1 0 0.8 0 0.6" mode="fixed" />
        <camera name="side_view" pos="0 1.0 0.6" xyaxes="-1 0 0 0 0 1" mode="fixed" />
        <camera name="top_view" pos="0.5 0 1.5" xyaxes="1 0 0 0 1 0" mode="fixed" />
    </worldbody>
</mujoco>
